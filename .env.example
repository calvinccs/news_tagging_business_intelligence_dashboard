# Environment variables for News Tagging Demo
# Copy this file to .env and adjust values as needed.

# Application
APP_NAME="News Tagging Demo"
APP_VERSION="0.1.0"
DEBUG=false

# Database (SQLite)
DATABASE_URL="sqlite:///./data/news_tagging.db"

# API
API_PREFIX="/api/v1"

# Data paths (relative to project root)
DATA_DIR="data"
RAW_ARTICLES_DIR="data/raw"
PROCESSED_ARTICLES_DIR="data/processed"
